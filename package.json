{
  "name": "comics.banast.as",
  "private": true,
  "version": "1.0.0",
  "description": "A static-first comic collection browser built with Astro, with analytics, clean routes, and a read-only API.",
  "license": "MIT",
  "homepage": "https://comics.banast.as",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banastas/comics.banast.as.git"
  },
  "bugs": {
    "url": "https://github.com/banastas/comics.banast.as/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "npm run validate:data && npm run typecheck && npm run lint && npm run test:run && npm run build && npm run verify:dist",
    "lint": "eslint .",
    "typecheck": "npm run typecheck:astro && npm run typecheck:functions && npm run typecheck:node",
    "typecheck:astro": "astro check",
    "typecheck:functions": "tsc -p tsconfig.functions.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "validate:data": "node scripts/validate-data.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:http": "node scripts/verify-http.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.5",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vitest": "^5.1.0"
  }
}
