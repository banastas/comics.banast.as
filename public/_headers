# Static asset headers. Pages Functions (functions/api/*) do not receive these
# rules; their security and cache headers are set in functions/_shared/http.ts.
#
# Content-Security-Policy notes:
# - script-src allows inline scripts by hash. The build replaces the
#   placeholder token in script-src with the hashes of every inline script in the
#   generated pages (integrations/static-output.mjs), so edits never need a
#   hand-computed hash.
# - style-src needs 'unsafe-inline' for Astro's island styles and React style
#   attributes. Fonts are self-hosted.
# - Google Analytics 4 hosts follow Google's published CSP guidance.
# - Cloudflare Web Analytics is injected on the production domain only: its
#   beacon loads from static.cloudflareinsights.com and reports to
#   cloudflareinsights.com.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' '__INLINE_SCRIPT_HASHES__' https://*.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://covers.banast.as https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://cloudflareinsights.com; manifest-src 'self'; worker-src 'self'; frame-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# Fingerprinted build output never changes at a given URL.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The collection data file changes with every sync.
/data/*
  Cache-Control: public, max-age=300

# Crawler files change on deploy; keep them short-lived. HTML keeps the
# Cloudflare Pages default (revalidate on every request).
/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

# Unhashed icons, manifest, and social image: cache for a day.
/manifest.json
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/favicon-16x16.png
  Cache-Control: public, max-age=86400

/favicon-32x32.png
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/icon-192.png
  Cache-Control: public, max-age=86400

/icon-512.png
  Cache-Control: public, max-age=86400

/og-image.jpg
  Cache-Control: public, max-age=86400
