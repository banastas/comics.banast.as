---
import { Layers } from 'lucide-react';
import DetailPage from '../components/astro/DetailPage.astro';
import { seriesCountLabel } from '../components/detailText';
import { comics as allComics } from '../utils/site-data';
import { groupMeta } from '../utils/page-meta';

const comics = allComics.filter((comic) => comic.isVariant);
const seriesCount = new Set(comics.map((comic) => comic.seriesName)).size;
---
<DetailPage
  meta={groupMeta('Variant Covers', comics.length, comics, '/variants')}
  source={{ kind: 'variants' }}
  comics={comics}
  breadcrumbItems={[{ label: 'Collection', href: '/' }, { label: 'Variants' }]}
  icon={Layers}
  iconBgColor="bg-orange-600"
  title="Variant Covers"
  subtitle={seriesCountLabel(comics.length, 'variant cover', seriesCount)}
  defaultSortBy="series"
  comicsListTitle="Variant covers"
  breakdown={{ title: 'Variant covers by series', maxItems: 8, itemLabel: 'variant' }}
/>
