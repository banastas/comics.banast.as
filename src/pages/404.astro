---
import BaseLayout from '../layouts/BaseLayout.astro';
import { notFoundMeta } from '../utils/page-meta';
---
<BaseLayout meta={notFoundMeta()}>
  <main id="main-content" class="grid flex-1 place-items-center p-6">
    <div class="space-y-4 text-center">
      <p aria-hidden="true" class="text-5xl font-bold text-slate-600">404</p>
      <h1 class="text-2xl font-bold text-white">That page is not in this collection.</h1>
      <p class="text-slate-400">The link may be outdated. Search above or return to browse the collection.</p>
      <a href="/" class="inline-block rounded-xl bg-blue-600 px-4 py-3 font-semibold text-ink hover:bg-blue-500">Return to the collection</a>
    </div>
  </main>
</BaseLayout>
