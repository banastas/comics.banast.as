---
import { Archive } from 'lucide-react';
import DetailPage from '../components/astro/DetailPage.astro';
import { seriesCountLabel } from '../components/detailText';
import { comics as allComics } from '../utils/site-data';
import { groupMeta } from '../utils/page-meta';

const comics = allComics.filter((comic) => comic.isSlabbed);
const seriesCount = new Set(comics.map((comic) => comic.seriesName)).size;
---
<DetailPage
  meta={groupMeta('Slabbed Comics', comics.length, comics, '/slabbed')}
  source={{ kind: 'slabbed' }}
  comics={comics}
  breadcrumbItems={[{ label: 'Collection', href: '/' }, { label: 'Slabbed Comics' }]}
  icon={Archive}
  iconBgColor="bg-purple-600"
  title="Slabbed Comics"
  subtitle={seriesCountLabel(comics.length, 'slabbed comic', seriesCount)}
  defaultSortBy="value"
  comicsListTitle="Slabbed comics"
  breakdown={{ title: 'Slabbed comics by series', maxItems: 8 }}
/>
